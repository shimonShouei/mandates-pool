# Shared admin password for the site-wide results, parties, and surplus agreements.
ADMIN_SECRET=replace-with-a-long-random-string

# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
# Hobby allows one run a day. The schedule in vercel.json is 0 3 * * *.
# Visitors refresh results on demand, at most once every few minutes.
CRON_SECRET=replace-with-another-random-string

# Postgres connection string. Required on Vercel. Omit locally to use data/mandates.db (SQLite).
# The Neon integration sets DATABASE_URL to the pooled host. A *.neon.tech host
# without -pooler is rewritten to the pooler unless DATABASE_DIRECT=1.
# DATABASE_URL=postgres://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct connection used for schema migrations. The Neon integration already
# sets one of these, so DATABASE_DIRECT does not need to be added.
# DATABASE_URL_UNPOOLED=postgres://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# POSTGRES_URL_NON_POOLING=
# DATABASE_DIRECT=1

# Optional. When empty, the app tries the Central Elections Committee hosts
# for the configured Knesset number (votesNN.bechirot.gov.il/nationalresults).
# RESULTS_SOURCE_URL=

# Optional. Datacenter requests to votesNN.bechirot.gov.il usually get an AWS WAF
# challenge or a geo-block. After that, the same official URL is read as HTML
# through this prefix. Set to empty to disable the reader. Default: https://r.jina.ai/
# RESULTS_READER_URL=

# Optional override of the local SQLite file.
# SQLITE_PATH=

# Auth.js. Required for sign-in in production. openssl rand -base64 32
# Locally, a development secret is used when this is unset.
# The site still runs when this is unset: sign-in stays disabled.
AUTH_SECRET=replace-with-a-long-random-string

# Optional. On Vercel, leave this unset. trustHost uses the request host,
# which is the production domain or the deployment host in VERCEL_URL.
# AUTH_URL=https://your-project.vercel.app

# Optional Google OAuth. Both are required or the button stays hidden.
# Redirect: https://<host>/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Optional Resend magic links. Free tier is about 3,000 emails/month and 100/day.
# Without a key, production hides the email form. Outside production the link
# is shown on /signin. EMAIL_FROM is a verified sender, needed for real mail.
# AUTH_RESEND_KEY=
# EMAIL_FROM=Mandatim <login@example.com>

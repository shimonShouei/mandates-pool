# Shared admin password for the site-wide results, parties, and surplus agreements.
ADMIN_SECRET=replace-with-a-long-random-string

# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
# Hobby runs this about once a day. Visitors refresh results on demand, at most once every few minutes.
CRON_SECRET=replace-with-another-random-string

# Postgres connection string (Neon free tier is enough).
# Required on Vercel. Omit locally to use data/mandates.db (SQLite).
# A *.neon.tech host is rewritten to the -pooler host unless DATABASE_DIRECT=1.
# DATABASE_URL=postgres://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_DIRECT=

# Optional. When empty, the app tries the Central Elections Committee hosts
# for the configured Knesset number (votesNN.bechirot.gov.il/nationalresults).
# RESULTS_SOURCE_URL=

# Optional override of the local SQLite file.
# SQLITE_PATH=
